# Backend settings for the local end-to-end stack. Copy to backend.env (git-ignored) and
# load it before starting the backend: set -a; . ./backend.env; set +a; deno task start
# Nothing here points at production: Firestore is the emulator, mail goes to the test inbox.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
FIRESTORE_PROJECT_ID=ai-translated-newsletter
SMTP_TEST_HOST=127.0.0.1:2525
EMAIL_HOST=smtp.test
EMAIL_USER=news@aiban.news
EMAIL_PASSWORD=not-used-by-the-test-inbox
EMAIL_SENDER_EMAIL=news@aiban.news
EMAIL_SENDER_NAME=AIBAN
PORT=8000
PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:4300
CORS_ORIGINS=http://localhost:4300
ADMIN_EMAILS=admin@aiban.test
LINK_SIGNING_SECRET=any-long-random-string-for-local-tests
APP_ENV=development
# The AI steps (preview, rewrite, translate) still need a real OPENROUTER_API_KEY from the
# backend's own .env. Those calls cost a few cents per full run.
